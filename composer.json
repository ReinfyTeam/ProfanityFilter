{
    "name": "reinfyteam/profanityfilter",
    "description": "PocketMine-MP plugin that filters profanity in chat and commands.",
    "license": "LGPL-3.0-only",
    "type": "pocketmine-plugin",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/axolotl-pm/PocketMine-MP",
            "no-api": true
        }
    ],
    "scripts": {
        "analyze": "vendor/bin/phpstan",
        "test": "@php tests/ui-word-display.php",
        "prepare-pharynx": "@php tools/prepare-pharynx.php",
        "build": [
            "@prepare-pharynx",
            "php -dphar.readonly=0 vendor/bin/pharynx -i=. -c -p=ProfanityFilter.phar"
        ],
        "build-source": [
            "@prepare-pharynx",
            "php -dphar.readonly=0 vendor/bin/pharynx -i=. -c -o=./output/"
        ]
    },
    "require": {
        "axolotl-pm/pocketmine-mp": "5.49.1",
        "sof3/infoapi": "^2.0.0-beta.1",
        "paroxity/commando": "3.2.0",
        "muqsit/simple-packet-handler": "0.1.5",
        "dktapps/pmforms": "^2.3"
    },
    "require-dev": {
        "sof3/pharynx": "^0.3.0",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "autoload": {
        "classmap": [
            "src"
        ]
    }
}
